% Gabarit pandoc des corrigés publiés (brut et guidé). Contenu sans marque ni nom de site.
% Compilation : lualatex (latexmk -lualatex).
% Le Markdown reste la source unique : ne pas éditer ce fichier .tex à la main.
\documentclass[11pt,a4paper]{article}

% --- Moteur, polices (Latin Modern) et langue ---------------------------------
\usepackage{iftex}
\ifLuaTeX\else\errmessage{Ce document se compile avec lualatex}\fi
\usepackage{amsmath,amssymb,mathtools}
\usepackage{fontspec}
% mathrm=sym : \mathrm prend ses glyphes dans la police mathématique (ℓ, μ, Ω), comme KaTeX.
\usepackage[math-style=TeX,bold-style=TeX,mathrm=sym]{unicode-math}
% Repli pour les glyphes absents de Latin Modern (indices et exposants Unicode,
% flèches, filets des schémas en texte, symboles) : DejaVu, puis Latin Modern Math
% (ℓ, lettres mathématiques Unicode des légendes).
\directlua{
  luaotfload.add_fallback("repliTexte", {"DejaVuSerif:mode=harf;", "DejaVuSans:mode=harf;", "file:latinmodern-math.otf:mode=harf;"})
  luaotfload.add_fallback("repliMono", {"DejaVuSansMono:mode=harf;", "DejaVuSans:mode=harf;", "file:latinmodern-math.otf:mode=harf;"})
}
\setmainfont{Latin Modern Roman}[RawFeature={fallback=repliTexte}]
\setsansfont{Latin Modern Sans}[RawFeature={fallback=repliTexte}]
\setmonofont{Latin Modern Mono}[RawFeature={fallback=repliMono}]
\setmathfont{Latin Modern Math}
$if(arabe)$
\usepackage[bidi=basic,french]{babel}
$elseif(hebreu)$
\usepackage[bidi=basic,french]{babel}
$else$
\usepackage[french]{babel}
$endif$
$if(arabe)$
\babelprovide[import,onchar=ids fonts]{arabic}
\babelfont[arabic]{rm}[Renderer=HarfBuzz,RawFeature={fallback=repliTexte}]{Noto Naskh Arabic}
\babelfont[arabic]{sf}[Renderer=HarfBuzz,RawFeature={fallback=repliTexte}]{Noto Naskh Arabic}
$endif$
$if(hebreu)$
\babelprovide[import,onchar=ids fonts]{hebrew}
\babelfont[hebrew]{rm}[Renderer=HarfBuzz,RawFeature={fallback=repliTexte}]{Noto Serif Hebrew}
\babelfont[hebrew]{sf}[Renderer=HarfBuzz,RawFeature={fallback=repliTexte}]{Noto Sans Hebrew}
$endif$
$if(russe_balise)$
% Si les motifs russes manquent, une langue distincte préserve la ponctuation russe.
\babelprovide[import,hyphenrules=russian +]{russian}
\babelfont[russian]{rm}{DejaVu Serif}
$endif$
$if(chinois)$
% Identifie les caractères han et autorise les coupures entre idéogrammes, y compris
% dans une phrase bilingue. Les groupes de chiffres et la ponctuation restent liés.
\babelprovide[import,onchar=ids fonts,hyphenrules=unhyphenated]{chinese-simplified}
\babelfont[chinese-simplified]{rm}[Renderer=HarfBuzz]{Noto Serif CJK SC}
\babelfont[chinese-simplified]{sf}[Renderer=HarfBuzz]{Noto Sans CJK SC}
$endif$
$if(japonais)$
% La locale japonaise traite ensemble les kana, les kanji et la ponctuation.
\babelprovide[import,onchar=ids fonts,hyphenrules=unhyphenated]{japanese}
\babelfont[japanese]{rm}[Renderer=HarfBuzz]{Noto Serif CJK JP}
\babelfont[japanese]{sf}[Renderer=HarfBuzz]{Noto Sans CJK JP}
$endif$
\frenchsetup{SmallCapsFigTabCaptions=false}

% --- Mise en page --------------------------------------------------------------
\usepackage[a4paper,margin=2.2cm,headheight=14pt,footskip=1.2cm]{geometry}
\usepackage{microtype}
\setlength{\emergencystretch}{4em}
\tolerance=1500
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.55\baselineskip plus 2pt minus 1pt}
\usepackage{xcolor}
% Gris nommés : babel-french rend « ! » actif dans le document.
\definecolor{gris2}{gray}{0.98}
\definecolor{gris3}{gray}{0.97}
\definecolor{gris5}{gray}{0.95}
\definecolor{gris35}{gray}{0.65}
\definecolor{gris40}{gray}{0.60}
\definecolor{gris45}{gray}{0.55}
\definecolor{gris50}{gray}{0.50}
\definecolor{gris55}{gray}{0.45}
\definecolor{gris60}{gray}{0.40}
\definecolor{gris65}{gray}{0.35}
\definecolor{gris70}{gray}{0.30}
\definecolor{gris80}{gray}{0.20}
\definecolor{gris85}{gray}{0.15}
\usepackage{graphicx}
\usepackage{float}
\usepackage{caption}
\captionsetup{font=small,labelformat=empty,justification=centering}
\usepackage{booktabs,longtable,array,multirow,calc}
\usepackage{siunitx}
\sisetup{locale=FR}
\usepackage[version=4]{mhchem}
\usepackage{listings}
\usepackage{fancyhdr}
$if(arabe)$
\fancyhfinit{\selectlanguage{french}}
$endif$
\usepackage{lastpage}
\usepackage[most]{tcolorbox}
\usepackage{enumitem}
\setlist{nosep,leftmargin=*,topsep=2pt}
% Hyperref installe les ancres des titres non numérotés si titlesec est déjà chargé.
\usepackage{titlesec}
\usepackage[hidelinks,unicode]{hyperref}
\usepackage{bookmark}
\hypersetup{pdftitle={$titre$},pdfauthor={Rédigé par IA},pdfcreator={LaTeX},pdfsubject={$nature$}}
\usepackage{xurl}

% --- Pandoc : listes, tableaux, figures ----------------------------------------
\providecommand{\passthrough}[1]{#1}
\providecommand{\tightlist}{\setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}

\makeatletter
\def\maxwidth{\ifdim\Gin@nat@width>\linewidth\linewidth\else\Gin@nat@width\fi}
\def\maxheight{\ifdim\Gin@nat@height>0.55\textheight 0.55\textheight\else\Gin@nat@height\fi}
\makeatother
\setkeys{Gin}{width=\maxwidth,height=\maxheight,keepaspectratio}
\setcounter{secnumdepth}{-\maxdimen}
\providecommand{\pandocbounded}[1]{#1}
$if(tables)$
\usepackage{longtable,booktabs,array}
$endif$

% --- Code (listings) -----------------------------------------------------------
\lstset{
  basicstyle=\ttfamily\small,
  columns=fullflexible,
  keepspaces=true,
  breaklines=true,
  breakatwhitespace=false,
  postbreak=\mbox{\textcolor{gris50}{$$\hookrightarrow$$}\space},
  frame=single,
  rulecolor=\color{gris35},
  framesep=4pt,
  xleftmargin=5pt,xrightmargin=5pt,
  backgroundcolor=\color{gris3},
  keywordstyle=\bfseries,
  commentstyle=\color{gris65},
  stringstyle=\color{gris80},
  showstringspaces=false,
  tabsize=4,
  extendedchars=true,
  aboveskip=6pt,belowskip=6pt,
}

% --- Macros des corrigés (KaTeX ↔ LaTeX) ---------------------------------------
% Les corrigés sont écrits pour KaTeX : on définit ici ce que KaTeX connaît et
% que LaTeX n'a pas, sans jamais retoucher le Markdown.
\providecommand{\R}{\mathbb{R}}
\providecommand{\N}{\mathbb{N}}
\providecommand{\Z}{\mathbb{Z}}
\providecommand{\Q}{\mathbb{Q}}
\providecommand{\C}{\mathbb{C}}
\providecommand{\dd}{\mathrm{d}}
\providecommand{\llbracket}{\lBrack}
\providecommand{\rrbracket}{\rBrack}
\providecommand{\lBrace}{\lbrace}
\providecommand{\rBrace}{\rbrace}
\providecommand{\Box}{\square}
\providecommand{\Diamond}{\lozenge}
\providecommand{\varnothing}{\emptyset}
\providecommand{\argmax}{\operatorname*{arg\,max}}
\providecommand{\argmin}{\operatorname*{arg\,min}}
\renewcommand{\leq}{\leqslant}
\renewcommand{\geq}{\geqslant}

% Équation hors texte : réduite à la largeur de la ligne si elle déborde.
\newsavebox{\boiteequation}
\newcommand{\equationajustee}[1]{%
  \sbox{\boiteequation}{$$\displaystyle #1$$}%
  \ifdim\wd\boiteequation>\linewidth
    \[\resizebox{\linewidth}{!}{\usebox{\boiteequation}}\]%
  \else
    \[#1\]%
  \fi}

% --- Encadrés pédagogiques (sobres, lisibles en noir et blanc) -----------------
\tcbset{
  encadre/.style={
    enhanced,breakable,sharp corners,
    colback=white,colframe=gris55,
    boxrule=0.4pt,leftrule=2.2pt,
    left=6pt,right=6pt,top=3pt,bottom=3pt,
    before skip=6pt,after skip=6pt,
    fonttitle=\bfseries\small,coltitle=black,
    attach title to upper,after title={\quad},
    parbox=false,
  }
}
\newtcolorbox{indication}[1]{encadre,colframe=gris45,colback=gris2,title={Indication~#1}}
\newtcolorbox{methode}{encadre,colframe=gris70,title={Méthode}}
\newtcolorbox{piege}{encadre,colframe=gris85,boxrule=0.8pt,leftrule=2.2pt,title={Piège}}
\newtcolorbox{jury}{encadre,colframe=gris60,colback=gris5,title={Jury}}
\newtcolorbox{encadrenote}{encadre,colframe=gris40}

% --- Titres de section ---------------------------------------------------------
\titleformat{\section}{\Large\bfseries}{}{0pt}{}
\titleformat{\subsection}{\large\bfseries}{}{0pt}{}
\titleformat{\subsubsection}{\normalsize\bfseries}{}{0pt}{}
\titlespacing*{\section}{0pt}{14pt plus 4pt minus 2pt}{6pt}
\titlespacing*{\subsection}{0pt}{10pt plus 3pt minus 2pt}{4pt}
\titlespacing*{\subsubsection}{0pt}{8pt plus 2pt minus 2pt}{2pt}

% --- En-tête et pied de page ---------------------------------------------------
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\textsc{$nature$} · $concours$ $filiere$}
\fancyhead[R]{\small $matiere$ $annee$}
$if(mesurerentete)$
% Garder les deux extrémités sur une ligne si leur largeur réelle le permet.
% Sinon chaque libellé dispose de toute la largeur et peut revenir à la ligne.
\newsavebox{\boiteentete}
\AddToHook{begindocument/before}{%
  \sbox{\boiteentete}{\small\textsc{$nature$} · $concours$ $filiere$\quad $matiere$ $annee$}%
  \ifdim\wd\boiteentete>\textwidth
    \sbox{\boiteentete}{\parbox[b]{\textwidth}{\small\setlength{\parskip}{0pt}%
      \raggedright\strut\textsc{$nature$} · $concours$ $filiere$\strut\par
      \raggedleft\strut $matiere$ $annee$\strut\par}}%
    \addtolength{\textheight}{\headheight}%
    \setlength{\headheight}{\dimexpr\ht\boiteentete+\dp\boiteentete+3pt\relax}%
    \addtolength{\textheight}{-\headheight}%
    \fancyhead{}%
    \fancyhead[C]{\usebox{\boiteentete}}%
  \fi}
$endif$
\fancyfoot[L]{\footnotesize Corrigé rédigé par IA, non officiel}
\fancyfoot[R]{\footnotesize \thepage\,/\,\pageref*{LastPage}}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[R]{\footnotesize \thepage\,/\,\pageref*{LastPage}}\fancyfoot[L]{\footnotesize Corrigé rédigé par IA, non officiel}\renewcommand{\headrulewidth}{0pt}}

\begin{document}
\thispagestyle{plain}
\begin{center}
  {\small\scshape $nature$}\par\smallskip
  {\LARGE\bfseries $titre$\par}\medskip
  {\large $concours$ · $filiere$ · $matiere$ · $annee$\par}
\end{center}
\vspace{2pt}\hrule\vspace{8pt}

$body$

\end{document}
