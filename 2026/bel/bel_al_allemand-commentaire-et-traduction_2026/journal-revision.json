  "commentaire_integral": [
    {
      "lignes": "1–17",
      "releve": "L’arrivée à Bonn, le détail des gestes, le compteur du taxi, les inversions après le départ de Marie."
    },
    {
      "lignes": "18–29",
      "releve": "Métier, fiscalité confessionnelle, rôle de la répétition et de l’agent dans la préparation de l’artiste."
    },
    {
      "lignes": "29–45",
      "releve": "Dans le bain, le répertoire liturgique est rapporté à l’école, au soin des deux maux et à la perte de Marie."
    },
    {
      "lignes": "45–57",
      "releve": "Le conditionnel distingue le souhait du soulagement temporaire. Le fil de la marionnette fait revenir le narrateur à lui-même."
    }
