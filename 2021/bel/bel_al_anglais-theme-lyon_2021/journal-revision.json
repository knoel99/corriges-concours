  "controle_paragraphe": [
    {
      "numero": 1,
      "contenu": "Retour des fils au centre-ville, véhicules, cinq provenances et huit familles.",
      "incipit_anglais": "At the end of the rainy",
      "explicit_anglais": "Olguins, the Olids, the Olmoses …"
    },
    {
      "numero": 2,
      "contenu": "Échange ancien des demeures de pierre rose contre les villas et les châteaux, toitures, colonnes, jacuzzis et trois formes des piscines.",
      "incipit_anglais": "Long ago their parents had traded",
      "explicit_anglais": "shaped like hearts, guitars and strawberries."
    },
    {
      "numero": 3,
      "contenu": "Maintien des droits et transformation commerciale des maisons.",
      "incipit_anglais": "But they had never relinquished their",
      "explicit_anglais": "or restaurants serving steaks grilled gaucho-style."
    },
    {
      "numero": 4,
      "contenu": "Fondation de l’Emporio dans une ville dégradée.",
      "incipit_anglais": "In the midst of this ruined",
      "explicit_anglais": "humanities and the pursuit of knowledge."
    },
    {
      "numero": 5,
      "contenu": "Origines familiales de Thomas et trois métiers, distance envers le pouvoir, Quitupan et le fleuve.",
      "incipit_anglais": "Thomas Moises did not come from",
      "explicit_anglais": "the headwaters of the Tepalcatepec River."
    },
    {
      "numero": 6,
      "contenu": "Rencontre personnelle, traits du visage et détails du costume, fondation à cinquante ans, tradition et mémoire, de l’Athénée à la Halle.",
      "incipit_anglais": "The first time I met him,",
      "explicit_anglais": "of Emporio, meaning the Market Hall."
    }
